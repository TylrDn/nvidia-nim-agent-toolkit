# NVIDIA NIM API
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_API_KEY=your_nim_api_key_here
NIM_DEFAULT_MODEL=meta/llama3-70b-instruct

# Langfuse Observability
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith (optional, for evals)
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=nvidia-nim-agent-toolkit

# Database (for sql_agent)
DB_URL=postgresql://user:password@localhost:5432/agentdb

# Vector Store (for doc_agent)
CHROMA_HOST=localhost
CHROMA_PORT=8000
