# NVIDIA NIM API
# NIM_API_KEY is the canonical key. NVIDIA_API_KEY is accepted as a fallback
# for backward compatibility — set either one.
NIM_API_KEY=your_nim_api_key_here
NVIDIA_API_KEY=
NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NIM_DEFAULT_MODEL=meta/llama-3.1-70b-instruct

# Langfuse Observability (tracing is disabled gracefully if unset)
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# LangSmith (optional, for evals)
LANGSMITH_API_KEY=your_langsmith_api_key
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=nvidia-nim-agent-toolkit

# Database (for sql_agent)
DATABASE_URL=sqlite:///./demo.db

# Vector store (for doc_agent)
FAISS_INDEX_PATH=./faiss_index

# Logging — set LOG_FORMAT=json for structured logs
LOG_LEVEL=INFO
LOG_FORMAT=text
